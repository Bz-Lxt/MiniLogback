MINILOGBACK_HTTP_ADDR=:8080
MINILOGBACK_INGEST_ADDR=:9010
MINILOGBACK_RING_CAPACITY=65536
MINILOGBACK_BATCH_SIZE=1024
MINILOGBACK_FLUSH_INTERVAL=50ms
MINILOGBACK_MAX_EVENT_BYTES=1048576
MINILOGBACK_AUDIT_MODE=full
MINILOGBACK_LEASE_TIMEOUT=2s
MINILOGBACK_AUDIT_INTERVAL=100ms
MINILOGBACK_SINK=file
MINILOGBACK_LOG_PATH=/data/minilogback.log
MINILOGBACK_NETWORK_ADDR=127.0.0.1:28641
MINILOGBACK_NETWORK_DIAL_TIMEOUT=2s
MINILOGBACK_NETWORK_IO_TIMEOUT=5s
MINILOGBACK_NETWORK_RETRY_INITIAL=50ms
MINILOGBACK_NETWORK_RETRY_MAXIMUM=2s
MINILOGBACK_NETWORK_MAX_ATTEMPTS=8
MINILOGBACK_ROTATE_BYTES=67108864
MINILOGBACK_SYNC_ON_FLUSH=false
MINILOGBACK_DEMO_MODE=true
MINILOGBACK_CONTAINER_MODE=false
MINILOGBACK_PROJECT_ROOT=.
MINILOGBACK_WEB_DIR=./frontend/dist
MINILOGBACK_SHUTDOWN_TIMEOUT=5s
MINILOGBACK_COLLECTOR_MAX_CONNECTIONS=256
MINILOGBACK_COLLECTOR_READ_TIMEOUT=10s
MINILOGBACK_COLLECTOR_DEDUPE_ENTRIES=100000
MINILOGBACK_PROTOCOL_MAX_RECORDS=1024
MINILOGBACK_PROTOCOL_MAX_PAYLOAD=16777216
MINILOGBACK_TELEMETRY_INTERVAL=100ms
MINILOGBACK_SSE_MAX_CLIENTS=64
MINILOGBACK_VERSION=dev

# Stable host-facing defaults used by docker compose.
MINILOGBACK_HTTP_PORT=28640
MINILOGBACK_INGEST_PORT=28641
